{
    "name": "babdev/babdev.com",
    "description": "The babdev.com website",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-hash": "*",
        "composer-runtime-api": "^2.0",
        "babdev/laravel-breadcrumbs": "^2.0@dev",
        "blade-ui-kit/blade-icons": "1.8.0",
        "filament/filament": "4.0.19",
        "guzzlehttp/guzzle": "7.10.0",
        "guzzlehttp/psr7": "2.8.0",
        "knplabs/github-api": "3.16.0",
        "laravel/framework": "12.30.1",
        "laravel/nightwatch": "1.13.7",
        "lcobucci/jwt": "5.5.0",
        "league/commonmark": "2.7.1",
        "owenvoke/blade-fontawesome": "2.9.1",
        "spatie/laravel-feed": "4.4.2",
        "spatie/laravel-google-fonts": "1.4.4",
        "spatie/laravel-sitemap": "7.3.7",
        "spatie/laravel-sluggable": "3.7.5"
    },
    "require-dev": {
        "driftingly/rector-laravel": "2.0.7",
        "fakerphp/faker": "1.24.1",
        "larastan/larastan": "3.7.2",
        "laravel/telescope": "5.11.4",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "8.8.2",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.1.28",
        "phpstan/phpstan-mockery": "2.0.0",
        "phpstan/phpstan-phpunit": "2.0.7",
        "phpunit/phpunit": "12.3.12",
        "rector/rector": "2.1.7",
        "spatie/laravel-ignition": "2.9.1"
    },
    "replace": {
        "paragonie/random_compat": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi",
            "@php artisan filament:upgrade"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.11"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
